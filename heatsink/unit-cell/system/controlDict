FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application     chtMultiRegionSimpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      2;
writeFormat     ascii;
writePrecision  7;
timeFormat      general;
runTimeModifiable true;
