FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/air";
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 1e5;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 1e5;
    }
    outlet
    {
        type            calculated;
        value           uniform 1e5;
    }
    walls
    {
        type            calculated;
        value           uniform 1e5;
    }
    symLeft
    {
        type            symmetryPlane;
    }
    symRight
    {
        type            symmetryPlane;
    }
    air_to_heatsink
    {
        type            calculated;
        value           uniform 1e5;
    }
}
