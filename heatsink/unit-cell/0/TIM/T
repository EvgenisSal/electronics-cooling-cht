FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/TIM";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;

boundaryField
{
    symLeft
    {
        type            symmetryPlane;
    }
    symRight
    {
        type            symmetryPlane;
    }
    walls
    {
        type            zeroGradient;
    }
    TIM_to_heatsink
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 300;
    }
    TIM_to_chip
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 300;
    }
}
