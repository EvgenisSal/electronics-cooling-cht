FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/TIM";
    object      thermophysicalProperties;
}

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   100;
    }
    transport
    {
        kappa       5;
    }
    thermodynamics
    {
        Hf          0;
        Cp          1000;
    }
    equationOfState
    {
        rho         2500;
    }
}
