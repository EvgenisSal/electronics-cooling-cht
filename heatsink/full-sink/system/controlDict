FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application     chtMultiRegionSimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10000;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      2;
writeFormat     ascii;
writePrecision  7;
timeFormat      general;
runTimeModifiable true;


functions
{
    wallHeatFlux_heatsink
    {
        type            wallHeatFlux;
        libs            ("libfieldFunctionObjects.so");
        region          heatsink;
        patches         (heatsink_to_air heatsink_to_TIM);
        writeControl    writeTime;
    }

    inletPressure
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          air;
        regionType      patch;
        name            inlet;
        operation       average;
        fields          (p_rgh);
        writeControl    writeTime;
        writeFields     false;
    }

    outletPressure
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          air;
        regionType      patch;
        name            outlet;
        operation       average;
        fields          (p_rgh);
        writeControl    writeTime;
        writeFields     false;
    }
}

