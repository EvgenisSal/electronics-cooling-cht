FoamFile
{
	version		2.0;
	format		ascii;
	class		dictionary;
	object		controlDict;
}

application	chtMultiRegionSimpleFoam;

startFrom	startTime;
startTime	0;

stopAt		endTime;
endTime		1000;

deltaT		1;

writeControl	timeStep;
writeInterval	1000;
purgeWrite	2;

writeFormat		ascii;
writePrecision		10;
writeCompression	off;

timeFormat	general;
timePrecision	6;

runTimeModifiable true;


functions
{
    wallHeatFlux_aluminium
    {
        type            wallHeatFlux;
        libs            ("libfieldFunctionObjects.so");
        region          aluminium;
        patches         (aluminium_to_TIM hot);
        writeControl    writeTime;
    }

    wallHeatFlux_TIM
    {
        type            wallHeatFlux;
        libs            ("libfieldFunctionObjects.so");
        region          TIM;
        patches         (TIM_to_aluminium cold);
        writeControl    writeTime;
    }
}
